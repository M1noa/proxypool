      "extract": {
        "root": "data.data",
        "ip": "ip",
        "port": "port",
        "protocols": "site_protocol",
        "country": "country",
        "anonymity": "anonymity"
      },
      "pagination": {
        "type": "page",
        "start": 1,
        "step": 1,
        "stop": "empty",
        "max_pages": 10
      }
    },
    {
      "name": "floppydata",
      "display": "floppydata.com (geoxy)",
      "home": "https://floppydata.com/",
      "url": "https://geoxy.io/proxies?count=99999",
      "format": "json",
      "prefetch": [
        {
          "url": "https://floppydata.com/free-proxy/",
          "regex": "Authorization[\"']?\\s*:\\s*[\"']([^\"']+)[\"']",
          "group": 1,
          "header": "Authorization"
        }
      ],
      "extract": {
        "root": "",
        "ip": "address",
        "protocols": "protocols",
        "country": "country",
        "anonymity": "anonymityLevel",
        "response_time": "ping"
      }
    },
    {
      "name": "proxybros",
      "display": "proxybros.com",
      "home": "https://proxybros.com/",
      "url": "https://proxybros.com/free-proxy-list/",
      "format": "json",
      "prefetch": [
        {
          "url": "https://proxybros.com/wp-admin/admin-ajax.php",
          "method": "POST",
          "body_type": "form",
          "body": {
            "action": "nrproxyexport",
            "type": "2",
            "lang": "en",
            "path": "/free-proxy-list/"
          },
          "json_path": "href",
          "as_url": true
        }
      ],
      "extract": {
        "root": "",
        "ip": "IP_Address",
        "port": "Port",
        "protocols": "Type",
        "anonymity": "Anonymity",
        "country": "Country",
        "response_time": "Delay"
      }
    },
    {
      "name": "freeproxyworld",
      "display": "freeproxy.world",
      "home": "https://www.freeproxy.world/",
      "url": "https://www.freeproxy.world/?page={page}",
      "format": "html",
      "antibot": true,
      "extract": {
        "row_selector": "table tbody tr",
        "ip": "td:nth-child(1)",
        "port": "td:nth-child(2)",
        "country": {
          "selector": "td:nth-child(3)",
          "regex": "country=([A-Za-z]{2})"
        },
        "response_time": "td:nth-child(5)",
        "protocol": "td:nth-child(6)",
        "anonymity": "td:nth-child(7)"
      },
      "pagination": {
        "type": "page",
        "start": 1,
        "step": 1,
        "stop": "empty",
        "max_pages": 30
      }
    },
