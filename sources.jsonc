    {
      "name": "proxyverity",
      "display": "proxyverity.com",
      "home": "https://proxyverity.com/",
      "url": "https://proxyverity.com/free-proxy-list/?page={page}",
      "format": "html",
      "antibot": true,
      "extract": {
        "row_selector": "table tbody tr:not(.pv-decoy)",
        "ip": {
          "selector": "td:nth-child(1) [data-p]",
          "attr": "data-p",
          "decode": "base64_reverse"
        },
        "protocol": "td:nth-child(2)",
        "country": {
          "selector": "td:nth-child(3) img",
          "attr": "src",
          "regex": "/flags/([A-Za-z]{2})\\."
        },
        "anonymity": "td:nth-child(4)",
        "response_time": "td:nth-child(7)"
      },
      "pagination": {
        "type": "page",
        "start": 1,
        "step": 1,
        "stop": "empty",
        "max_pages": 10
      }
