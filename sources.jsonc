    {
      "name": "myproxy",
      "display": "my-proxy.com",
      "home": "https://www.my-proxy.com/",
      "format": "text",
      "protocol": "http",
      "extract": {
        "regex": "(?P<ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?P<port>\\d{1,5})#(?P<country>[A-Z]{2})",
        "finditer": true
      },
      "urls": [
        {"url": "https://www.my-proxy.com/free-proxy-list-{page}.html"},
        {"url": "https://www.my-proxy.com/free-elite-proxy.html", "set": {"anonymity": "elite"}},
        {"url": "https://www.my-proxy.com/free-anonymous-proxy.html", "set": {"anonymity": "anonymous"}},
        {"url": "https://www.my-proxy.com/free-transparent-proxy.html", "set": {"anonymity": "transparent"}},
        {"url": "https://www.my-proxy.com/free-socks-4-proxy.html", "set": {"protocol": "socks4", "anonymity": "elite"}},
        {"url": "https://www.my-proxy.com/free-socks-5-proxy.html", "set": {"protocol": "socks5", "anonymity": "elite"}}
      ],
      "pagination": {"type": "page", "start": 1, "step": 1, "stop": "empty", "max_pages": 10}
    },
