// proxypool source definitions — single source of truth.
// no per-source code exists anywhere else; everything is driven from this file.
//
// schema per source:
//   name           unique id, used in output["proxies"][].sources
//   url            fetch url; "{page}" / "{offset}" placeholders if paginated
//   fallback_url   optional, tried if primary fetch fails
//   method         GET (default) | POST
//   headers        optional request headers
//   body           optional json body (POST)
//   format         "json" | "text" | "html"
//   protocol       default protocol when content carries none:
//                  "http" | "https" | "socks4" | "socks5"; omit for mixed/auto
//   extract        format-specific:
//     json:
//       root          dotted path to list of items (omit = whole doc is list)
//       ip/port/etc   dotted paths into each item object
//       regex         applied to item when items are strings (named groups:
//                     proto/ip/port); proto group optional
//     text:
//       regex         applied per line, named groups proto/ip/port
//     html:
//       row_selector  css selector for table/body rows
//       <field>       css selector relative to row (e.g. "td:nth-child(1)")
//   pagination     optional: { type: "page"|"offset", start, step,
//                              stop: "empty", max_pages }
//   includes       metadata this source already provides — checker skips
//                  these fields downstream: country|anonymity|https|protocols
{
  "sources": [
    {
      "name": "proxifly",
      "url": "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/all/data.json",
      "format": "json",
      "extract": {
        "root": "",
        "ip": "ip",
        "port": "port",
        "protocol": "protocol",
        "country": "geolocation.country",
        "anonymity": "anonymity",
        "https": "https"
      },
      "source_meta": {
        "city": "geolocation.city",
        "score": "score"
      },
      "includes": [
        "country",
        "anonymity",
        "https",
        "protocols"
      ]
    },
    {
      "name": "geonode",
      "url": "https://proxylist.geonode.com/api/proxy-list?page={page}&limit=500&sort_by=responseTime&sort_type=asc",
      "format": "json",
      "pagination": {
        "type": "page",
        "start": 1,
        "step": 1,
        "stop": "empty",
        "max_pages": 20
      },
      "extract": {
        "root": "data",
        "ip": "ip",
        "port": "port",
        "protocols": "protocols",
        "country": "country",
        "anonymity": "anonymityLevel",
        "response_time": "responseTime"
      },
      "source_meta": {
        "city": "city",
        "isp": "isp",
        "org": "org"
      },
      "includes": [
        "country",
        "anonymity",
        "protocols"
      ]
    },
    {
      "name": "nodemaven",
      "url": "https://freeproxies.nodemaven.com/proxies?per_page=1000000",
      "format": "json",
      "extract": {
        "root": "proxies",
        "ip": "ip_address",
        "port": "port",
        "protocol": "protocol",
        "country_name": "country",
        "anonymity": "type"
      },
      "source_meta": {
        "latency": "latency",
        "upstream_source": "source_name",
        "response": "response",
        "google": "google",
        "last_checked_src": "last_checked"
      },
      "includes": [
        "anonymity",
        "protocols"
      ]
    },
    {
      "name": "roundproxies",
      "url": "https://roundproxies.com/api/get-free-proxies/?limit=500&page={page}&sort_by=lastChecked&sort_type=desc",
      "format": "json",
      "pagination": {
        "type": "page",
        "start": 1,
        "step": 1,
        "stop": "empty",
        "max_pages": 20
      },
      "extract": {
        "root": "data",
        "ip": "ip",
        "port": "port",
        "protocols": "protocols",
        "country": "country",
        "anonymity": "anonymity",
        "response_time": "responseTime"
      },
      "source_meta": {
        "city": "city",
        "isp": "isp",
        "org": "org",
        "uptime": "upTime"
      },
      "includes": [
        "country",
        "anonymity",
        "protocols"
      ]
    },
    {
      "name": "proxiware",
      "url": "https://papi.proxiware.com/proxies?page={page}",
      "format": "json",
      "pagination": {
        "type": "page",
        "start": 1,
        "step": 1,
        "stop": "empty",
        "max_pages": 50
      },
      "extract": {
        "root": "proxies",
        "ip": "addr",
        "port": "port",
        "protocol": "protocol",
        "country": "country_code",
        "anonymity": "anonymity"
      },
      "source_meta": {
        "speed_ms": "speed_ms"
      },
      "includes": [
        "country",
        "anonymity",
        "protocols"
      ]
    },
    {
      "name": "sunny9577",
      "url": "https://sunny9577.github.io/proxy-scraper/proxies.json",
      "format": "json",
      "extract": {
        "root": "",
        "ip": "ip",
        "port": "port",
        "protocol": "type",
        "country_name": "country",
        "anonymity": "anonymity"
      },
      "includes": [
        "anonymity",
        "protocols"
      ]
    },
    {
      "name": "proxyscrape",
      "url": "https://cdn.jsdelivr.net/gh/proxyscrape/free-proxy-list@main/proxies/all/data.json",
      "format": "json",
      "extract": {
        "root": "proxies",
        "ip": "ip",
        "port": "port",
        "protocol": "protocol",
        "country": "ip_data.countryCode",
        "anonymity": "anonymity",
        "https": "ssl"
      },
      "source_meta": {
        "uptime": "uptime",
        "times_alive": "times_alive",
        "times_dead": "times_dead",
        "average_timeout": "average_timeout",
        "city": "ip_data.city",
        "isp": "ip_data.isp"
      },
      "includes": [
        "country",
        "anonymity",
        "https",
        "protocols"
      ]
    },
    {
      "name": "speedx-http",
      "url": "https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt",
      "format": "text",
      "protocol": "http",
      "extract": {
        "regex": "^(?:(?P<proto>[a-z0-9]+)://)?(?P<ip>\\d{1,3}(?:\\.\\d{1,3}){3}):(?P<port>\\d{2,5})\\s*$"
      },
      "includes": []
    },
