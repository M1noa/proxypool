    // ---- premiumproxy.net + proxydocker (html tables) ----
    {
      "name": "premiumproxy",
      "url": "https://premiumproxy.net/full-proxy-list/",
      "format": "html",
      "extract": {
        "row_selector": "table tbody tr",
        "ip": "td:nth-child(1)",
        "protocol": "td:nth-child(2)",
        "anonymity": "td:nth-child(3)",
        "country": "td:nth-child(4)"
      },
      "includes": ["anonymity", "protocols"]
    },
    {
      "name": "proxydocker",
      "url": "https://www.proxydocker.com/en/proxylist/",
      "format": "html",
      "extract": {
        "row_selector": "table.plist tr",
        "ip": "td:nth-child(1)",
        "protocol": "td:nth-child(2)",
        "anonymity": "td:nth-child(3)",
        "country": { "selector": "td:nth-child(6)", "regex": "^([A-Z]{2})" }
      },
      "includes": ["anonymity", "protocols", "country"]
    }
  ]
}
